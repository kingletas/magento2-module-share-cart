<?xml version="1.0"?>
<!-- Renders the share control on the cart page. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="cart.summary">
            <block class="Magento\Framework\View\Element\Template"
                   name="commerce.share.cart"
                   template="Commerce_ShareCart::share-cart.phtml"
                   after="checkout.cart.methods">
                <arguments>
                    <argument name="view_model" xsi:type="object">Commerce\ShareCart\ViewModel\ShareCartButton</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
